---
const personalImageAlt = "Xavier"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/photoMe.jpeg"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/xavier-forteza-bernat-702925a2/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Open to work</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, I'm Xavier
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    +8 years of experience on <strong
      > IT System Administrator and Devops Engineer </strong
    > from Sóller, Mallorca 🇪🇸, currently based in Canada 🇨🇦. <br /> Specialized in infrastructure automation and cloud systems optimization.
  </p>

  <!-- Información adicional -->
  <p class="mt-6 text-lg text-gray-800 dark:text-gray-300">
    With expertise in Infrastructure as Code (IaC), Kubernetes, and cloud environments like AWS and Azure, I focus on automating complex systems to ensure high availability, scalability, and efficiency. I have extensive experience in tools like AWX, EDA, Github, Ansible, Powerhsell, Bash, Kubernetes, ArgoCD and others, allowing me to optimize workflows and drive operational excellence.
  </p>
  
  <p class="mt-4 text-lg text-gray-800 dark:text-gray-300">
    From leading Kubernetes deployments to designing disaster recovery plans, my work helps improve the resilience and security of IT infrastructures. I am passionate about finding innovative solutions that enable seamless cloud operations.
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:xavi.fortesa@gmail.com">
      <MailIcon class="size-4" />
      Contact me
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/xavier-forteza-bernat-702925a2/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
